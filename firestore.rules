rules_version = '2';

// The rules are the backend: the app talks to Firestore directly.
// One allowlist, config/access.emails, edited by hand in the console; the app
// and the home server read the same document. Every allow and deny below has
// a case in firestore-tests/rules.test.mjs.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
           get(/databases/$(database)/documents/config/access).data.emails;
    }

    // minVersion and its message: read before sign-in, so even a signed-out
    // old build learns it must update.
    match /config/app {
      allow read: if true;
    }

    // The allowlist and the early (patient-zero) users. Readable only by
    // those on it: the app's access check is exactly this read succeeding.
    match /config/access {
      allow read: if allowed();
    }

    // Each person's own profile: sign-in times, push tokens, notification switches.
    match /users/{uid} {
      allow read: if allowed() && request.auth.uid == uid;
      allow create, update: if allowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'lastSignIn', 'previousSignIn',
             'previousPlatform', 'lastPlatform', 'fcmTokens', 'notify']);
    }

    // --- Print Studio ---------------------------------------------------------
    // The customer never reaches Firestore: the portal goes through the Pi
    // (server/app/studio.py, Admin SDK), which also writes versions, the
    // customer's comments and the approval. So the app may not.

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    match /customers/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'lang', 'portalToken', 'notes', 'createdAt'])
        && shortText(request.resource.data.name, 200) && request.resource.data.name.size() > 0
        && request.resource.data.lang in ['he', 'en']
        // The portal link's secret: long enough not to be guessed.
        && request.resource.data.portalToken is string
        && request.resource.data.portalToken.size() >= 22;
    }

    match /requests/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'title', 'qty', 'notes', 'status',
             'latestVersion', 'createdAt', 'updatedAt'])
        && shortText(request.resource.data.title, 200) && request.resource.data.title.size() > 0
        && request.resource.data.qty is int && request.resource.data.qty >= 1
        && request.resource.data.status == 'draft'
        && request.resource.data.latestVersion == 0;
      // Approval fields are the server's. An approved request keeps the
      // version, the price and the quantity the customer approved.
      allow update: if allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'qty', 'notes', 'status',
             'publishedVersionId', 'quoteId', 'needsReply', 'customerName', 'updatedAt'])
        && request.resource.data.status in ['draft', 'waiting', 'approved', 'printing', 'ready', 'delivered', 'paid']
        && shortText(request.resource.data.title, 200)
        && request.resource.data.qty is int && request.resource.data.qty >= 1
        && (resource.data.status in ['draft', 'waiting']
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publishedVersionId', 'quoteId', 'qty']));
      allow delete: if allowed() && resource.data.status == 'draft';
    }

    match /versions/{id} {
      allow read: if allowed();
      // Publishing (and its note); approved versions are frozen.
      allow update: if allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'publishedAt', 'note'])
        && request.resource.data.state in ['draft', 'published']
        && resource.data.state != 'approved'
        && shortText(request.resource.data.note, 500);
      allow delete: if allowed() && resource.data.state == 'draft';
    }

    // A price is never edited: a new quote replaces it, so the customer sees
    // the history and approves exactly the one they were shown.
    match /quotes/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['requestId', 'customerId', 'unit', 'qty', 'vatPercent', 'note', 'createdAt', 'by'])
        && request.resource.data.unit is int && request.resource.data.unit >= 0
        && request.resource.data.qty is int && request.resource.data.qty >= 1
        && request.resource.data.vatPercent is int
        && request.resource.data.vatPercent >= 0 && request.resource.data.vatPercent <= 100
        && shortText(request.resource.data.note, 1000);
    }

    match /comments/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['requestId', 'customerId', 'versionId', 'versionN', 'from', 'text', 'pin', 'createdAt'])
        && request.resource.data.from == 'studio'
        && shortText(request.resource.data.text, 2000) && request.resource.data.text.size() > 0;
      // Marking a client comment handled (or open again): only those two fields.
      allow update: if allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt'])
        && request.resource.data.done is bool;
      allow delete: if allowed() && resource.data.from == 'studio';
    }

    // Problem reports when there is no home server: write-only; the notifier
    // forwards them to Telegram with the Admin SDK.
    match /reports/{id} {
      allow create: if allowed() && request.resource.data.uid == request.auth.uid;
    }
  }
}
