rules_version = '2';

// The rules are the backend: the app talks to Firestore directly.
// One allowlist, config/access.emails, edited by hand in the console; the app
// and the home server read the same document. Every allow and deny below has
// a case in firestore-tests/rules.test.mjs.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in
           get(/databases/$(database)/documents/config/access).data.emails;
    }

    // minVersion and its message: read before sign-in, so even a signed-out
    // old build learns it must update.
    match /config/app {
      allow read: if true;
    }

    // The allowlist and the early (patient-zero) users. Readable only by
    // those on it: the app's access check is exactly this read succeeding.
    match /config/access {
      allow read: if allowed();
    }

    // Each person's own profile: sign-in times, push tokens, notification switches.
    match /users/{uid} {
      allow read: if allowed() && request.auth.uid == uid;
      allow create, update: if allowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'name', 'email', 'lastSignIn', 'previousSignIn',
             'previousPlatform', 'lastPlatform', 'fcmTokens', 'notify']);
    }

    // --- Print Studio ---------------------------------------------------------
    // The customer never reaches Firestore: the portal goes through the Pi
    // (server/app/studio.py, Admin SDK), which also writes versions, the
    // customer's comments and the approval. So the app may not.

    function kept(f) {
      return !(f in request.resource.data) || (resource != null && f in resource.data && resource.data[f] == request.resource.data[f]);
    }

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    // A request's deadline: a day "2026-11-12" or none (the Pi reminds by it, jobs.deadline_reminders).
    function deadlineOk(d) {
      return !('deadline' in d) || d.deadline == null || (d.deadline is string && d.deadline.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    // The shop's product slug (B4: gifts.slug on the website), or none.
    function giftOk(d) {
      return !('gift' in d) || d.gift == null || (d.gift is string && d.gift.matches('[a-z0-9-]{1,60}'));
    }

    match /customers/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'lang', 'kind', 'portalToken', 'notes', 'createdAt',
             'googleUid', 'googleEmail', 'billing', 'returning'])
        // A regular customer (לקוח קבוע): a personal area behind Google sign-in (studio.py signs_in).
        && (!('returning' in request.resource.data) || request.resource.data.returning is bool)
        // The monthly payment request (server/app/billing.py): off only when false.
        && (!('billing' in request.resource.data) || request.resource.data.billing is bool)
        // The Google account that owns a gift link is set by the server only; the app may keep or remove it.
        && kept('googleUid') && kept('googleEmail')
        && shortText(request.resource.data.name, 200) && request.resource.data.name.size() > 0
        && request.resource.data.lang in ['he', 'en']
        // A microphone-flag customer or a gift customer; older ones have none.
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['mic', 'gift'])
        // The portal link's secret: long enough not to be guessed.
        && request.resource.data.portalToken is string
        && request.resource.data.portalToken.size() >= 22;
    }

    match /requests/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['customerId', 'customerName', 'title', 'qty', 'notes', 'status',
             'latestVersion', 'createdAt', 'updatedAt', 'deadline', 'gift'])
        && deadlineOk(request.resource.data) && giftOk(request.resource.data)
        && shortText(request.resource.data.title, 200) && request.resource.data.title.size() > 0
        && request.resource.data.qty is int && request.resource.data.qty >= 1
        && request.resource.data.status == 'draft'
        && request.resource.data.latestVersion == 0;
      // production (Gift Factory's reports) and guests (the client's list) are the server's too
      // (server/app/giftfactory.py): in neither list, so the app can't write them, nor drop
      // them with a whole-document set(); every app write is update() or set(..., merge).
      // Approval fields are the server's. An approved request keeps the
      // version, the price and the quantity the customer approved.
      allow update: if allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'qty', 'notes', 'status',
             'publishedVersionId', 'offeredVersionIds', 'quoteId', 'needsReply', 'customerName', 'updatedAt', 'deadline', 'gift'])
        && deadlineOk(request.resource.data) && giftOk(request.resource.data)
        // declined is the client's (server); Alex may set it too, and back to reopen.
        && request.resource.data.status in ['draft', 'waiting', 'approved', 'printing', 'ready', 'delivered', 'paid', 'declined']
        && shortText(request.resource.data.title, 200)
        && request.resource.data.qty is int && request.resource.data.qty >= 1
        // Versions published side by side: the client approves one of them (studio.py offered()).
        && (!('offeredVersionIds' in request.resource.data)
            || (request.resource.data.offeredVersionIds is list && request.resource.data.offeredVersionIds.size() <= 10))
        && (resource.data.status in ['draft', 'waiting']
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['publishedVersionId', 'offeredVersionIds', 'quoteId', 'qty']));
      allow delete: if allowed() && resource.data.status == 'draft';
    }

    match /versions/{id} {
      allow read: if allowed();
      // Publishing (and its note); approved versions are frozen.
      allow update: if allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'publishedAt', 'note'])
        && request.resource.data.state in ['draft', 'published']
        && resource.data.state != 'approved'
        && shortText(request.resource.data.note, 500);
      allow delete: if allowed() && resource.data.state == 'draft';
    }

    // A price is never edited: a new quote replaces it, so the customer sees
    // the history and approves exactly the one they were shown.
    match /quotes/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['requestId', 'customerId', 'unit', 'qty', 'vatPercent', 'note', 'createdAt', 'by', 'discount', 'discountPct', 'correction'])
        // A correction of a mistake: the client no longer sees any earlier price of the request.
        && (!('correction' in request.resource.data) || request.resource.data.correction is bool)
        && request.resource.data.unit is int && request.resource.data.unit >= 0
        && request.resource.data.qty is int && request.resource.data.qty >= 1
        && request.resource.data.vatPercent is int
        && request.resource.data.vatPercent >= 0 && request.resource.data.vatPercent <= 100
        // A discount (agorot) comes off the whole price, never below zero; discountPct only shows how it was given.
        && (!('discount' in request.resource.data) || (request.resource.data.discount is int
            && request.resource.data.discount >= 0 && request.resource.data.discount <= request.resource.data.unit * request.resource.data.qty))
        && (!('discountPct' in request.resource.data) || (request.resource.data.discountPct is int
            && request.resource.data.discountPct >= 0 && request.resource.data.discountPct <= 100))
        && shortText(request.resource.data.note, 1000);
    }

    // Money received for a request, in agorot. A mistake is deleted and entered again, never edited.
    match /payments/{id} {
      allow read, delete: if allowed();
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['requestId', 'customerId', 'amount', 'method', 'note', 'at', 'createdAt'])
        && request.resource.data.requestId is string && request.resource.data.customerId is string
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && request.resource.data.method in ['bit', 'paybox', 'transfer', 'cash', 'check', 'other']
        && request.resource.data.at is timestamp
        && shortText(request.resource.data.note, 500);
    }

    match /comments/{id} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['requestId', 'customerId', 'versionId', 'versionN', 'from', 'text', 'pin', 'createdAt'])
        && request.resource.data.from == 'studio'
        && shortText(request.resource.data.text, 2000) && request.resource.data.text.size() > 0;
      // Marking a client comment handled (or open again): only those two fields.
      allow update: if allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneAt'])
        && request.resource.data.done is bool;
      allow delete: if allowed() && resource.data.from == 'studio';
    }

    // The studio's details on a payment request (server/app/billing.py): business, bank, Bit, PayBox, billing day.
    match /config/billing {
      allow read: if allowed();
      allow write: if allowed()
        && request.resource.data.keys().hasOnly(['businessName', 'businessId', 'contact', 'bankName', 'bankNumber', 'branch',
             'account', 'accountName', 'bitOn', 'bitPhone', 'payboxOn', 'payboxLink', 'day', 'updatedAt'])
        && request.resource.data.day is int && request.resource.data.day >= 1 && request.resource.data.day <= 28
        && request.resource.data.bitOn is bool && request.resource.data.payboxOn is bool
        && shortText(request.resource.data.get('businessName', ''), 200) && shortText(request.resource.data.get('businessId', ''), 100)
        && shortText(request.resource.data.get('contact', ''), 200) && shortText(request.resource.data.get('bankName', ''), 100)
        && shortText(request.resource.data.get('bankNumber', ''), 10) && shortText(request.resource.data.get('branch', ''), 10)
        && shortText(request.resource.data.get('account', ''), 30) && shortText(request.resource.data.get('accountName', ''), 200)
        && shortText(request.resource.data.get('bitPhone', ''), 30) && shortText(request.resource.data.get('payboxLink', ''), 300);
    }

    // Payment requests: the server makes and numbers them. The app marks one sent; marks an open one paid
    // with its receipt; moves one to the trash (deletedAt) or back. The Pi deletes it after 30 days there.
    match /bills/{id} {
      allow read: if allowed();
      allow update: if allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sentAt', 'state', 'paidAt', 'receipt', 'deletedAt'])
        && (request.resource.data.state == resource.data.state
            || (resource.data.state == 'open' && request.resource.data.state == 'paid'
                && request.resource.data.paidAt is timestamp
                && request.resource.data.receipt.keys().hasOnly(['number', 'url', 'to'])
                && request.resource.data.receipt.url is string && request.resource.data.receipt.url.matches('https://.{1,500}')
                && shortText(request.resource.data.receipt.number, 30) && shortText(request.resource.data.receipt.to, 200)))
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null || request.resource.data.deletedAt is timestamp);
    }

    // Problem reports when there is no home server: write-only; the notifier
    // forwards them to Telegram with the Admin SDK.
    match /reports/{id} {
      allow create: if allowed() && request.resource.data.uid == request.auth.uid;
    }
  }
}
